{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiAcceptanceEvidence",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "backend_revision",
    "route",
    "technical_pass",
    "business_evaluation",
    "executed_cases",
    "case_outcomes",
    "status",
    "model_revision",
    "requested_model",
    "actual_provider",
    "timing_seconds",
    "token_provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "java-worker-acceptance",
        "proxy-live-acceptance"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "backend_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_model": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actual_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "route": {
      "type": "string",
      "enum": [
        "direct",
        "fallback",
        "unknown"
      ]
    },
    "technical_pass": {
      "type": "boolean"
    },
    "business_evaluation": {
      "type": "object",
      "required": [
        "suggestion_only",
        "constraint_preservation",
        "policy_boundary_respected"
      ],
      "properties": {
        "suggestion_only": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "constraint_preservation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "policy_boundary_respected": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "executed_cases": {
      "type": "integer",
      "minimum": 1
    },
    "case_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_name",
          "status",
          "requested_model",
          "latency_ms"
        ],
        "properties": {
          "case_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED"
            ]
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "requested_model": {
            "type": "string",
            "minLength": 1
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "timing_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "token_provenance": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "prompt_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "completion_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "java-worker-acceptance"
          }
        }
      },
      "then": {
        "properties": {
          "model_revision": {
            "const": "233167bba5df61b5375a522bf8a042d8d2189379"
          },
          "executed_cases": {
            "const": 7
          }
        }
      },
      "else": {
        "properties": {
          "executed_cases": {
            "const": 3
          },
          "route": {
            "const": "unknown"
          },
          "actual_provider": {
            "type": "null"
          }
        }
      }
    }
  ]
}
