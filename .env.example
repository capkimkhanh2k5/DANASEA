POSTGRES_DB=PostGres_DataBase
POSTGRES_USER=PostGres_UserName
POSTGRES_PASSWORD=PostGres_PassWord
FRONTEND_PORT=3000
BACKEND_PORT=8080

APP_JWT_ACCESS_TOKEN_MINUTES=60
APP_JWT_SECRET=your_jwt_secret_key_minimum_256_bits

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_email_app_password

APP_PAYPAL_MODE=sandbox
APP_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
APP_PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
APP_PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key

AI_QUYET_ENABLED=false
AI_QUYET_BASE_URL=http://127.0.0.1:8091
AI_QUYET_API_KEY=
AI_QUYET_CONNECT_TIMEOUT=1s
AI_QUYET_READ_TIMEOUT=3s
QUYET_MODEL_DIR=
QUYET_CPU_THREADS=4

# CLI Proxy API Settings (Primary AI Provider)
AI_CLIPROXY_ENABLED=true
AI_CLIPROXY_BASE_URL=http://localhost:8318/v1
AI_CLIPROXY_API_KEY=
AI_CLIPROXY_MODEL=gemini-3.5-flash
AI_CLIPROXY_FALLBACK_MODEL=openai/gpt-oss-120b

# Google OAuth2 Settings (Backend & Web Frontend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Public Web client ID, embedded at frontend build time; use the same value as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

APP_CHECKIN_QR_SECRET=
APP_PAYMENT_WEBHOOK_SECRET=
POSTGRES_APP_USER=danasea_app
POSTGRES_APP_PASSWORD=
SPRING_REDIS_PASSWORD=
SPRING_RABBITMQ_USERNAME=danasea_app
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=/danasea
RABBITMQ_ADMIN_USER=danasea_admin
RABBITMQ_ADMIN_PASSWORD=
CLIPROXY_MANAGEMENT_KEY=
JAVA_TOOL_OPTIONS=-XX:+UseG1GC

# Set these to id -u / id -g of the non-root deployment user.
CLIPROXY_UID=1000
CLIPROXY_GID=1000
# Production must use the actual HTTPS frontend URLs.
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example
APP_PAYPAL_RETURN_URL=https://your-domain.example/payment/success
APP_PAYPAL_CANCEL_URL=https://your-domain.example/payment/cancel
