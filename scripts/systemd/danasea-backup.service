[Unit]
Description=DANASEA restore-verified local database backup
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=HOME=@HOME_DIR@
UMask=0077
ExecStart=/usr/bin/flock -w 1800 @APP_DIR@/.deploy.lock /usr/bin/python3 /usr/local/lib/danasea/backup.py --config /etc/danasea/backup.json
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@APP_DIR@ @BACKUP_DIR@
